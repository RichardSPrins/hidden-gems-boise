---
// src/layouts/AdminLayout.astro
// Admin console — auth-gated by middleware (ADMIN role required)

import BaseLayout from "./BaseLayout.astro";
import type { Props as BaseProps } from "./BaseLayout.astro";

export interface Props extends BaseProps {
  activeSection?:
    | "dashboard"
    | "businesses"
    | "submissions"
    | "claims"
    | "events"
    | "categories"
    | "gems"
    | "reviews";
}

const { activeSection, ...baseProps } = Astro.props;

const user = Astro.locals.user;

// Pending counts for nav badges — cheap, run once per admin page render.
const { db } = await import("@/lib/db");
const { business, event } = await import("@/lib/db/schema");
const { eq, count } = await import("drizzle-orm");
const [[{ pendingClaims }], [{ pendingEvents }]] = await Promise.all([
  db
    .select({ pendingClaims: count() })
    .from(business)
    .where(eq(business.claimStatus, "PENDING")),
  db
    .select({ pendingEvents: count() })
    .from(event)
    .where(eq(event.isActive, false)),
]);

const navItems = [
  { label: "Dashboard", href: "/admin", section: "dashboard", icon: "▦" },
  {
    label: "Businesses",
    href: "/admin/businesses",
    section: "businesses",
    icon: "▤",
  },
  {
    label: "Submissions",
    href: "/admin/submissions",
    section: "submissions",
    icon: "✎",
  },
  {
    label: "Claims",
    href: "/admin/claims",
    section: "claims",
    icon: "⚑",
    badge: pendingClaims,
  },
  {
    label: "Events",
    href: "/admin/events",
    section: "events",
    icon: "🗓",
    badge: pendingEvents,
  },
  {
    label: "Categories",
    href: "/admin/categories",
    section: "categories",
    icon: "◈",
  },
  { label: "Gem Spotlights", href: "/admin/gems", section: "gems", icon: "✦" },
];
---

<BaseLayout
  {...baseProps}
  noindex={true}
  nofollow={true}
  bodyClass="bg-gem-mist"
>
  <slot name="head" slot="head" />

  <header
    slot="header"
    class="admin-header fixed top-0 left-0 right-0 z-50 bg-gem-dark border-b border-gem-border-dark"
  >
    <div class="flex items-center justify-between px-6 h-16">
      <a
        href="/admin"
        class="font-display text-xl font-semibold text-white no-underline"
      >
        Hidden <span class="text-gem-gold">Gems</span>
        <span class="text-white/40 text-sm font-sans font-normal ml-2"
          >Admin</span
        >
      </a>

      <div class="flex items-center gap-4">
        <a
          href="/"
          class="text-sm text-white/50 hover:text-white transition-colors hidden sm:block"
          >View Site</a
        >
        <span class="text-sm text-white/50 hidden md:block">{user?.email}</span>
        <button
          type="button"
          data-sign-out
          class="text-sm text-white/50 hover:text-white transition-colors px-3 py-1.5 rounded-lg hover:bg-white/5"
        >
          Sign Out
        </button>
      </div>
    </div>
  </header>

  <div class="admin-body flex min-h-screen pt-16">
    <aside
      class="admin-sidebar w-60 shrink-0 bg-white border-r border-gem-border fixed top-16 bottom-0 left-0 overflow-y-auto hidden md:block"
    >
      <nav class="p-4" aria-label="Admin navigation">
        <p
          class="text-xs font-semibold tracking-widest uppercase text-gem-text-subtle px-3 mb-3"
        >
          Manage
        </p>
        <ul class="flex flex-col gap-1 list-none m-0 p-0">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all no-underline",
                    activeSection === item.section
                      ? "bg-gem-gold/10 text-gem-gold border border-gem-gold/20"
                      : "text-gem-text-muted hover:bg-gem-mist hover:text-gem-text",
                  ]}
                  aria-current={
                    activeSection === item.section ? "page" : undefined
                  }
                >
                  <span class="text-base font-mono">{item.icon}</span>
                  {item.label}
                  {item.badge ? (
                    <span class="ml-auto inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-gem-gold text-gem-dark text-xs font-semibold">
                      {item.badge}
                    </span>
                  ) : null}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 pt-4 border-t border-gem-border">
          <a
            href="/admin/businesses/new"
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-semibold bg-gem-gold text-gem-dark hover:bg-gem-gold-light transition-all no-underline"
          >
            <span class="text-base">+</span>
            New Listing
          </a>
        </div>
      </nav>
    </aside>

    <main
      id="main-content"
      class="flex-1 md:ml-60 p-6 pb-24 md:pb-6 min-h-screen"
    >
      <slot name="page-header" />
      <slot />
    </main>
  </div>

  <script is:inline>
    document.querySelectorAll("[data-sign-out]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        btn.setAttribute("disabled", "true");
        try {
          await fetch("/api/auth/sign-out", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: "{}",
          });
        } catch {}
        window.location.href = "/";
      });
    });
  </script>
  <slot name="scripts" slot="scripts" />
</BaseLayout>
