---
import PortalLayout from "@/layouts/PortalLayout.astro";
import { db } from "@/lib/db";
import { event } from "@/lib/db/schema";
import { desc, inArray } from "drizzle-orm";
import { portalUser, listOwnedBusinesses } from "@/lib/portal";

const user = portalUser(Astro.locals);
if (!user) return Astro.redirect("/auth/login?next=/portal/events");

const owned = await listOwnedBusinesses(user.id);
const ids = owned.map((b) => b.id);

const events = ids.length
  ? await db.query.event.findMany({
      where: inArray(event.businessId, ids),
      orderBy: desc(event.startDateTime),
      with: { business: { columns: { name: true } } },
    })
  : [];
---

<PortalLayout title="Events" activeSection="events">
  <div slot="page-header" class="mb-6 flex items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl text-gem-text">Events</h1>
      <p class="text-gem-text-muted text-sm mt-1">
        Events you've created. New events are reviewed before going live.
      </p>
    </div>
    {
      owned.length > 0 && (
        <a
          href="/portal/events/new"
          class="bg-gem-gold text-gem-dark font-semibold px-4 py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors no-underline shrink-0"
        >
          + New event
        </a>
      )
    }
  </div>

  {
    owned.length === 0 ? (
      <div class="bg-white border border-gem-border rounded-2xl p-8 text-center max-w-2xl">
        <p class="text-sm text-gem-text-muted mb-4">
          You need a claimed listing before you can post events.
        </p>
        <a
          href="/claim"
          class="inline-block bg-gem-gold text-gem-dark font-semibold px-5 py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors no-underline"
        >
          Claim your business
        </a>
      </div>
    ) : events.length === 0 ? (
      <p class="text-sm text-gem-text-muted bg-white border border-gem-border rounded-2xl p-6 max-w-2xl">
        No events yet. Create your first one.
      </p>
    ) : (
      <div class="max-w-3xl space-y-3">
        {events.map((e) => (
          <a
            href={`/portal/events/${e.id}`}
            class="flex items-center justify-between gap-4 bg-white border border-gem-border rounded-2xl p-4 hover:border-gem-gold transition-colors no-underline"
          >
            <div>
              <p class="font-medium text-gem-text">{e.title}</p>
              <p class="text-xs text-gem-text-subtle mt-0.5">
                {e.business?.name} · {new Date(e.startDateTime).toLocaleString()}
              </p>
            </div>
            {e.isActive ? (
              <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                Live
              </span>
            ) : (
              <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Pending
              </span>
            )}
          </a>
        ))}
      </div>
    )
  }
</PortalLayout>
