---
import PortalLayout from "@/layouts/PortalLayout.astro";
import { portalUser, getOwnedBusiness } from "@/lib/portal";

const user = portalUser(Astro.locals);
if (!user) return Astro.redirect("/auth/login?next=/portal/listings");

const { id } = Astro.params;
if (!id) return Astro.redirect("/portal/listings");

const biz = await getOwnedBusiness(user.id, id);
if (!biz) return Astro.redirect("/portal/listings");

const locations = biz.locations
  .slice()
  .sort((a, b) => Number(b.isPrimary) - Number(a.isPrimary));
---

<PortalLayout title={`${biz.name} — Locations`} activeSection="listings">
  <div slot="page-header" class="mb-6">
    <nav aria-label="Breadcrumb" class="text-xs text-gem-text-subtle mb-2">
      <a href="/portal/listings" class="hover:text-gem-gold">My Listings</a>
      <span class="mx-2">/</span>
      <a href={`/portal/listings/${biz.id}`} class="hover:text-gem-gold"
        >{biz.name}</a
      >
      <span class="mx-2">/</span>
      <span>Locations</span>
    </nav>
    <h1 class="font-display text-3xl text-gem-text">Locations</h1>
    <p class="text-gem-text-muted text-sm mt-1">
      Where customers can find {biz.name}. Add a location, then set its hours.
    </p>
  </div>

  <div class="max-w-3xl space-y-3 mb-8">
    {
      locations.length === 0 ? (
        <p class="text-sm text-gem-text-muted bg-white border border-gem-border rounded-2xl p-6">
          No locations yet. Add one below.
        </p>
      ) : (
        locations.map((loc) => (
          <a
            href={`/portal/listings/${biz.id}/locations/${loc.id}`}
            class="flex items-center justify-between gap-4 bg-white border border-gem-border rounded-2xl p-4 hover:border-gem-gold transition-colors no-underline"
          >
            <div>
              <p class="font-medium text-gem-text">
                {loc.address}
                {loc.isPrimary && (
                  <span class="ml-2 text-xs font-semibold text-gem-gold">
                    ★ Primary
                  </span>
                )}
              </p>
              <p class="text-xs text-gem-text-subtle mt-0.5">
                {loc.city}, {loc.state} {loc.zip}
                {loc.neighborhood ? ` · ${loc.neighborhood}` : ""} ·{" "}
                {loc.hours?.length ?? 0} days of hours set
              </p>
            </div>
            <span class="text-gem-text-subtle text-sm">Edit →</span>
          </a>
        ))
      )
    }
  </div>

  <section
    class="bg-white border border-gem-border rounded-2xl p-6 space-y-4 max-w-3xl"
    data-business-id={biz.id}
  >
    <h2 class="font-display text-lg text-gem-text">Add a location</h2>
    <form id="add-location-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1.5">Street address</label>
        <input
          name="address"
          required
          class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold"
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">City</label>
          <input
            name="city"
            required
            class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">State</label>
          <input
            name="state"
            value="ID"
            class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">ZIP</label>
          <input
            name="zip"
            required
            class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold"
          />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5">Neighborhood</label>
        <input
          name="neighborhood"
          class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold"
        />
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="isPrimary" value="1" />
        Make this the primary location
      </label>
      <div class="flex items-center gap-3">
        <button
          type="submit"
          id="add-btn"
          class="bg-gem-gold text-gem-dark font-semibold px-5 py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors disabled:opacity-50"
          >Add location</button
        >
        <p id="add-msg" class="text-sm hidden" role="status"></p>
      </div>
    </form>
  </section>

  <script is:inline define:vars={{ businessId: biz.id }}>
    const form = document.getElementById("add-location-form");
    const btn = document.getElementById("add-btn");
    const msg = document.getElementById("add-msg");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "Adding…";
      msg.classList.add("hidden");
      const fd = new FormData(form);
      const payload = {
        address: fd.get("address"),
        city: fd.get("city"),
        state: fd.get("state") || "ID",
        zip: fd.get("zip"),
        neighborhood: fd.get("neighborhood") || null,
        isPrimary: fd.get("isPrimary") === "1",
      };
      try {
        const res = await fetch(
          `/api/portal/businesses/${businessId}/locations`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          },
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Failed");
        window.location.href = `/portal/listings/${businessId}/locations/${data.id}`;
      } catch (err) {
        msg.textContent = err.message || "Failed to add.";
        msg.className = "text-sm text-red-600";
        msg.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Add location";
      }
    });
  </script>
</PortalLayout>
