---
import PortalLayout from "@/layouts/PortalLayout.astro";
import { portalUser } from "@/lib/portal";

const user = portalUser(Astro.locals);
if (!user) return Astro.redirect("/auth/login?next=/portal/account");

const full = Astro.locals.user as {
  name?: string | null;
  email?: string;
  emailVerified?: boolean;
} | null;
const verified = full?.emailVerified === true;
---

<PortalLayout title="Account" activeSection="account">
  <div slot="page-header" class="mb-6">
    <h1 class="font-display text-3xl text-gem-text">Account</h1>
    <p class="text-gem-text-muted text-sm mt-1">Your sign-in details.</p>
  </div>

  <div class="bg-white border border-gem-border rounded-2xl p-6 max-w-2xl space-y-4">
    <div>
      <p class="text-xs uppercase tracking-widest text-gem-text-subtle">Name</p>
      <p class="text-gem-text">{full?.name || "—"}</p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-widest text-gem-text-subtle">Email</p>
      <p class="text-gem-text font-mono">{full?.email}</p>
      {
        verified ? (
          <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
            Verified
          </span>
        ) : (
          <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
            Unverified
          </span>
        )
      }
    </div>

    <div class="pt-4 border-t border-gem-border flex items-center gap-4">
      <a
        href="/auth/forgot-password"
        class="text-sm font-semibold text-gem-gold hover:underline no-underline"
        >Change password</a
      >
      <button
        type="button"
        data-sign-out
        class="text-sm text-gem-text-muted hover:text-gem-text"
        >Sign out</button
      >
    </div>
  </div>
</PortalLayout>
