---
import BaseLayout from "@/layouts/BaseLayout.astro";

const url = new URL(Astro.request.url);
const token = url.searchParams.get("token") ?? "";
const error = url.searchParams.get("error");
const hasToken = token.length > 0 && !error;
---

<BaseLayout title="Reset Password" noindex={true} nofollow={true}>
  <div class="min-h-screen flex items-center justify-center bg-gem-mist px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="font-display text-2xl font-semibold text-gem-text no-underline">
          Hidden <span class="text-gem-gold">Gems</span>
        </a>
        <h1 class="font-display text-3xl mt-6 mb-2">Set a new password</h1>
        <p class="text-gem-text-muted text-sm">
          Pick something you'll remember. At least 8 characters.
        </p>
      </div>

      {!hasToken ? (
        <div class="bg-white border border-gem-border rounded-2xl p-6 shadow-sm">
          <p class="text-sm text-red-700 mb-3">
            {error === "INVALID_TOKEN"
              ? "This reset link has expired or already been used."
              : "We can't find a valid reset token. Request a new link to continue."}
          </p>
          <a href="/auth/forgot-password" class="text-gem-gold hover:underline text-sm">
            Request a new reset link →
          </a>
        </div>
      ) : (
        <form id="reset-form" class="bg-white border border-gem-border rounded-2xl p-6 space-y-4 shadow-sm" data-token={token}>
          <div>
            <label for="password" class="block text-sm font-medium text-gem-text mb-1.5">New password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="w-full px-3 py-2.5 rounded-lg border border-gem-border bg-white text-gem-text focus:outline-none focus:ring-2 focus:ring-gem-gold focus:border-transparent"
            />
          </div>
          <div>
            <label for="confirm" class="block text-sm font-medium text-gem-text mb-1.5">Confirm new password</label>
            <input
              id="confirm"
              name="confirm"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="w-full px-3 py-2.5 rounded-lg border border-gem-border bg-white text-gem-text focus:outline-none focus:ring-2 focus:ring-gem-gold focus:border-transparent"
            />
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-gem-gold text-gem-dark font-semibold py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors disabled:opacity-50"
          >
            Set new password
          </button>
          <p id="form-error" class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3 hidden" role="alert"></p>
        </form>
      )}
    </div>
  </div>

  {hasToken && (
    <script is:inline define:vars={{ token }}>
      const form = document.getElementById("reset-form");
      const btn = document.getElementById("submit-btn");
      const errEl = document.getElementById("form-error");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errEl.classList.add("hidden");

        const fd = new FormData(form);
        const pw = fd.get("password");
        const confirm = fd.get("confirm");
        if (pw !== confirm) {
          errEl.textContent = "Passwords don't match.";
          errEl.classList.remove("hidden");
          return;
        }

        btn.disabled = true;
        btn.textContent = "Saving…";

        try {
          const res = await fetch("/api/auth/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ newPassword: pw, token }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            errEl.textContent =
              data?.message ||
              "Could not reset password. The link may have expired — request a new one.";
            errEl.classList.remove("hidden");
            btn.disabled = false;
            btn.textContent = "Set new password";
            return;
          }

          window.location.href = "/auth/login?reset=success";
        } catch {
          errEl.textContent = "Network error. Please try again.";
          errEl.classList.remove("hidden");
          btn.disabled = false;
          btn.textContent = "Set new password";
        }
      });
    </script>
  )}
</BaseLayout>
