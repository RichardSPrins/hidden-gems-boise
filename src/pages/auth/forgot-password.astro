---
import BaseLayout from "@/layouts/BaseLayout.astro";

if (Astro.locals.user) {
  const role = (Astro.locals.user as { role?: string }).role;
  return Astro.redirect(role === "ADMIN" ? "/admin" : "/portal");
}
---

<BaseLayout title="Forgot Password" noindex={true} nofollow={true}>
  <div class="min-h-screen flex items-center justify-center bg-gem-mist px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="font-display text-2xl font-semibold text-gem-text no-underline">
          Hidden <span class="text-gem-gold">Gems</span>
        </a>
        <h1 class="font-display text-3xl mt-6 mb-2">Reset your password</h1>
        <p class="text-gem-text-muted text-sm">
          Enter your email and we'll send you a link to set a new one.
        </p>
      </div>

      <form id="forgot-form" class="bg-white border border-gem-border rounded-2xl p-6 space-y-4 shadow-sm">
        <div>
          <label for="email" class="block text-sm font-medium text-gem-text mb-1.5">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full px-3 py-2.5 rounded-lg border border-gem-border bg-white text-gem-text focus:outline-none focus:ring-2 focus:ring-gem-gold focus:border-transparent"
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-gem-gold text-gem-dark font-semibold py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors disabled:opacity-50"
        >
          Send reset link
        </button>
        <p id="form-msg" class="text-sm hidden" role="status"></p>
      </form>

      <p class="text-center text-sm text-gem-text-muted mt-4">
        Remembered it? <a href="/auth/login" class="text-gem-gold hover:underline">Sign in</a>
      </p>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById("forgot-form");
    const btn = document.getElementById("submit-btn");
    const msg = document.getElementById("form-msg");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "Sending…";
      msg.classList.add("hidden");

      const fd = new FormData(form);
      try {
        const res = await fetch("/api/auth/forget-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: fd.get("email"),
            redirectTo: "/auth/reset-password",
          }),
        });

        // Better Auth returns 200 with a generic message whether or not the email
        // exists, so we mirror that and never reveal account state to the user.
        if (res.ok) {
          msg.textContent =
            "If an account exists for that email, a reset link is on the way. Check your inbox.";
          msg.className = "text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg p-3";
          msg.classList.remove("hidden");
          btn.textContent = "Send reset link";
          btn.disabled = false;
          form.reset();
        } else {
          const data = await res.json().catch(() => ({}));
          msg.textContent = data?.message || "Something went wrong. Try again.";
          msg.className = "text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3";
          msg.classList.remove("hidden");
          btn.textContent = "Send reset link";
          btn.disabled = false;
        }
      } catch {
        msg.textContent = "Network error. Please try again.";
        msg.className = "text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3";
        msg.classList.remove("hidden");
        btn.textContent = "Send reset link";
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
