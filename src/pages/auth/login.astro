---
import BaseLayout from "@/layouts/BaseLayout.astro";

if (Astro.locals.user) {
  const role = (Astro.locals.user as { role?: string }).role;
  return Astro.redirect(role === "ADMIN" ? "/admin" : "/portal");
}

const next = Astro.url.searchParams.get("next") ?? "";
const flash = Astro.url.searchParams.get("reset") === "success"
  ? "Password updated. Sign in with your new password."
  : Astro.url.searchParams.get("verified") === "true"
  ? "Email verified. Sign in to continue."
  : null;
const verifyError = Astro.url.searchParams.get("error");
---

<BaseLayout title="Sign In" noindex={true} nofollow={true}>
  <div class="min-h-screen flex items-center justify-center bg-gem-mist px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="font-display text-2xl font-semibold text-gem-text no-underline">
          Hidden <span class="text-gem-gold">Gems</span>
        </a>
        <h1 class="font-display text-3xl mt-6 mb-2">Sign in</h1>
        <p class="text-gem-text-muted text-sm">
          Don't have an account?
          <a href={`/auth/sign-up${next ? `?next=${encodeURIComponent(next)}` : ""}`} class="text-gem-gold hover:underline">Sign up</a>
        </p>
      </div>

      {flash && (
        <div class="mb-4 p-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm" role="status">
          {flash}
        </div>
      )}
      {verifyError && !flash && (
        <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm" role="alert">
          {verifyError === "TOKEN_EXPIRED"
            ? "That verification link expired. Sign in to request a new one."
            : verifyError === "INVALID_TOKEN"
            ? "That link is no longer valid."
            : "Something went wrong with that link."}
        </div>
      )}

      <form id="login-form" class="bg-white border border-gem-border rounded-2xl p-6 space-y-4 shadow-sm">
        <div>
          <label for="email" class="block text-sm font-medium text-gem-text mb-1.5">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full px-3 py-2.5 rounded-lg border border-gem-border bg-white text-gem-text focus:outline-none focus:ring-2 focus:ring-gem-gold focus:border-transparent"
          />
        </div>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-sm font-medium text-gem-text">Password</label>
            <a href="/auth/forgot-password" class="text-xs text-gem-gold hover:underline">Forgot password?</a>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2.5 rounded-lg border border-gem-border bg-white text-gem-text focus:outline-none focus:ring-2 focus:ring-gem-gold focus:border-transparent"
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-gem-gold text-gem-dark font-semibold py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors disabled:opacity-50"
        >
          Sign in
        </button>
        <p id="form-error" class="text-sm text-red-600 hidden" role="alert"></p>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ next }}>
    const form = document.getElementById("login-form");
    const errEl = document.getElementById("form-error");
    const btn = document.getElementById("submit-btn");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.classList.add("hidden");
      btn.disabled = true;
      btn.textContent = "Signing in…";

      const fd = new FormData(form);
      try {
        const res = await fetch("/api/auth/sign-in/email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: fd.get("email"),
            password: fd.get("password"),
          }),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          errEl.textContent = data?.message || "Invalid email or password.";
          errEl.classList.remove("hidden");
          btn.disabled = false;
          btn.textContent = "Sign in";
          return;
        }

        const data = await res.json();
        const role = data?.user?.role;
        const target = next || (role === "ADMIN" ? "/admin" : "/portal");
        window.location.href = target;
      } catch (err) {
        errEl.textContent = "Network error. Please try again.";
        errEl.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Sign in";
      }
    });
  </script>
</BaseLayout>
