---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db } from "@/lib/db";
import { publicSubmission } from "@/lib/db/schema";
import { desc, eq } from "drizzle-orm";

const status = new URL(Astro.request.url).searchParams.get("status") ?? "PENDING";
const rows = await db.query.publicSubmission.findMany({
  where: status === "ALL" ? undefined : eq(publicSubmission.status, status),
  orderBy: desc(publicSubmission.createdAt),
  limit: 200,
});
const tabs = ["PENDING", "APPROVED", "REJECTED", "ALL"];
---

<AdminLayout title="Submissions" activeSection="submissions">
  <div slot="page-header" class="mb-6">
    <h1 class="font-display text-3xl text-gem-text">Submissions</h1>
    <p class="text-gem-text-muted text-sm mt-1">Public submissions from the /submit form.</p>
  </div>

  <div class="flex items-center gap-1 mb-4 bg-white border border-gem-border rounded-2xl p-1 w-fit">
    {tabs.map((t) => (
      <a
        href={`/admin/submissions?status=${t}`}
        class:list={[
          "text-sm px-3 py-1.5 rounded-lg no-underline",
          status === t ? "bg-gem-text text-white" : "text-gem-text-muted hover:text-gem-text",
        ]}
      >{t}</a>
    ))}
  </div>

  <div class="bg-white border border-gem-border rounded-2xl overflow-hidden">
    {rows.length === 0 ? (
      <div class="p-8 text-center text-sm text-gem-text-muted">Nothing here.</div>
    ) : (
      <table class="w-full text-sm">
        <thead class="bg-gem-mist text-left text-xs uppercase tracking-widest text-gem-text-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Business</th>
            <th class="px-4 py-3 font-semibold">Owner</th>
            <th class="px-4 py-3 font-semibold">Tier</th>
            <th class="px-4 py-3 font-semibold">Status</th>
            <th class="px-4 py-3 font-semibold">Submitted</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((s) => (
            <tr class="border-t border-gem-border hover:bg-gem-mist/50">
              <td class="px-4 py-3">
                <a href={`/admin/submissions/${s.id}`} class="font-medium text-gem-text hover:text-gem-gold no-underline">{s.businessName}</a>
              </td>
              <td class="px-4 py-3 text-gem-text-muted">{s.ownerName}<br /><span class="text-xs text-gem-text-subtle">{s.ownerEmail}</span></td>
              <td class="px-4 py-3 text-gem-text-muted">{s.tier}</td>
              <td class="px-4 py-3">
                <span class:list={[
                  "inline-block px-2 py-0.5 rounded-full text-xs font-medium",
                  s.status === "PENDING" && "bg-yellow-100 text-yellow-800",
                  s.status === "APPROVED" && "bg-green-100 text-green-700",
                  s.status === "REJECTED" && "bg-red-100 text-red-700",
                ]}>{s.status}</span>
              </td>
              <td class="px-4 py-3 text-xs text-gem-text-subtle">{new Date(s.createdAt).toLocaleDateString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>
