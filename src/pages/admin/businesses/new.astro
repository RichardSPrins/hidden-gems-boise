---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db } from "@/lib/db";
import { category, subcategory } from "@/lib/db/schema";
import { asc } from "drizzle-orm";

const categories = await db.query.category.findMany({
  orderBy: asc(category.name),
  with: { subcategories: { orderBy: asc(subcategory.name) } },
});

const socialPlatforms = [
  "INSTAGRAM",
  "FACEBOOK",
  "TIKTOK",
  "TWITTER",
  "YOUTUBE",
  "LINKEDIN",
  "YELP",
  "TRIPADVISOR",
  "OTHER",
];
---

<AdminLayout title="New Business" activeSection="businesses">
  <div slot="page-header" class="mb-6">
    <nav aria-label="Breadcrumb" class="text-xs text-gem-text-subtle mb-2">
      <a href="/admin/businesses" class="hover:text-gem-gold">Businesses</a>
      <span class="mx-2">/</span>
      <span>New</span>
    </nav>
    <h1 class="font-display text-3xl text-gem-text">Add a new listing</h1>
    <p class="text-gem-text-muted text-sm mt-1">
      Required: name, category, primary location. Everything else can be edited after.
    </p>
  </div>

  <form id="biz-form" class="space-y-6 max-w-3xl">
    <!-- Core -->
    <section class="bg-white border border-gem-border rounded-2xl p-6 space-y-4">
      <h2 class="font-display text-lg text-gem-text">Identity</h2>

      <div>
        <label class="block text-sm font-medium mb-1.5">Business name <span class="text-red-500">*</span></label>
        <input name="name" type="text" required class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Slug</label>
        <input name="slug" type="text" placeholder="auto-generated from name" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        <p class="text-xs text-gem-text-subtle mt-1">Leave blank to auto-generate. Will be made unique if there's a clash.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Category <span class="text-red-500">*</span></label>
          <select name="categoryId" required id="categoryId" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold">
            <option value="">Select…</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Subcategory</label>
          <select name="subcategoryId" id="subcategoryId" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold">
            <option value="">— pick a category first —</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Bio</label>
        <textarea id="bio-editor" name="bio" rows="10" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" placeholder="The business's description on their detail page. Markdown supported — headings, lists, links, bold/italic, images."></textarea>
        <p class="text-xs text-gem-text-muted mt-1">
          Markdown. Drag images into the editor or use the image button — they upload to R2 automatically.
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Editorial blurb</label>
        <textarea name="editorialBlurb" rows="3" maxlength="600" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" placeholder="50–80 words. Owner story, what makes them worth visiting. Used on the home page grid."></textarea>
        <p class="text-xs text-gem-text-subtle mt-1">Editorial-warm voice. Specific differentiators ("20 years," "owner-roasted") land harder than adjectives.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Website</label>
          <input name="websiteUrl" type="url" placeholder="https://…" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Booking URL</label>
          <input name="bookingUrl" type="url" placeholder="https://…" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Price point</label>
          <select name="pricePoint" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold">
            <option value="">—</option>
            <option value="ONE">$</option>
            <option value="TWO">$$</option>
            <option value="THREE">$$$</option>
            <option value="FOUR">$$$$</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Status</label>
          <select name="status" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold">
            <option value="APPROVED" selected>APPROVED (live)</option>
            <option value="DRAFT">DRAFT</option>
            <option value="PENDING_REVIEW">PENDING REVIEW</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Keywords</label>
        <input name="keywords" type="text" placeholder="comma-separated, e.g. coffee, pour over, local roaster" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
      </div>

      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="isVerified" value="1" />
        Mark as Verified Gem
      </label>
    </section>

    <!-- Location -->
    <section class="bg-white border border-gem-border rounded-2xl p-6 space-y-4">
      <h2 class="font-display text-lg text-gem-text">Primary location</h2>
      <p class="text-xs text-gem-text-subtle -mt-2">Required for the listing to render on the map / explore page.</p>

      <div>
        <label class="block text-sm font-medium mb-1.5">Street address <span class="text-red-500">*</span></label>
        <input name="address" type="text" required class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">City <span class="text-red-500">*</span></label>
          <input name="city" type="text" value="Boise" required class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">State</label>
          <input name="state" type="text" value="ID" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">ZIP <span class="text-red-500">*</span></label>
          <input name="zip" type="text" required class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Neighborhood</label>
          <input name="neighborhood" type="text" placeholder="Downtown, North End, …" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Lat</label>
          <input name="lat" type="number" step="any" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Lng</label>
          <input name="lng" type="number" step="any" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
      </div>
    </section>

    <!-- Contact + Image -->
    <section class="bg-white border border-gem-border rounded-2xl p-6 space-y-4">
      <h2 class="font-display text-lg text-gem-text">Contact &amp; primary image</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Phone</label>
          <input name="phone" type="tel" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Public email</label>
          <input name="email" type="email" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5">Primary image</label>
        <input
          type="file"
          id="image-file"
          accept="image/jpeg,image/png,image/webp"
          class="block w-full text-sm text-gem-text-muted file:mr-3 file:px-3 file:py-2 file:rounded-lg file:border-0 file:bg-gem-text file:text-white file:font-medium file:cursor-pointer file:hover:bg-gem-stone"
        />
        <input name="imageUrl" type="hidden" />
        <p id="image-status" class="text-xs text-gem-text-subtle mt-1">JPEG, PNG, or WebP. Max 5 MB. Optional — you can add it later.</p>
        <div id="image-preview" class="hidden mt-3">
          <img id="image-preview-img" alt="" class="rounded-lg max-h-48 border border-gem-border" />
          <button type="button" id="image-remove" class="text-xs text-red-600 hover:underline mt-2">Remove</button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5">Image alt text</label>
        <input name="imageAlt" type="text" placeholder="Describe what's in the image — used for accessibility & SEO" class="w-full px-3 py-2 rounded-lg border border-gem-border focus:outline-none focus:ring-2 focus:ring-gem-gold" />
      </div>
    </section>

    <!-- Socials -->
    <section class="bg-white border border-gem-border rounded-2xl p-6 space-y-4">
      <h2 class="font-display text-lg text-gem-text">Social links</h2>
      <div id="socials" class="space-y-2">
        <div class="flex gap-2 social-row">
          <select name="social-platform" class="px-3 py-2 rounded-lg border border-gem-border bg-white text-sm">
            {socialPlatforms.map((p) => <option value={p}>{p}</option>)}
          </select>
          <input name="social-url" type="url" placeholder="https://…" class="flex-1 px-3 py-2 rounded-lg border border-gem-border" />
        </div>
      </div>
      <button type="button" id="add-social" class="text-sm text-gem-gold hover:underline">+ add another</button>
    </section>

    <div class="flex items-center gap-3">
      <button type="submit" id="submit-btn" class="bg-gem-gold text-gem-dark font-semibold px-6 py-2.5 rounded-lg hover:bg-gem-gold-light transition-colors disabled:opacity-50">
        Save listing
      </button>
      <a href="/admin/businesses" class="text-sm text-gem-text-muted hover:text-gem-text">Cancel</a>
      <p id="form-error" class="text-sm text-red-600 hidden ml-auto" role="alert"></p>
    </div>
  </form>

  <link rel="stylesheet" href="https://unpkg.com/easymde@2.18.0/dist/easymde.min.css" />
  <script is:inline src="https://unpkg.com/easymde@2.18.0/dist/easymde.min.js"></script>

  <script is:inline define:vars={{ categories }}>
    // Bio rich-text editor — EasyMDE backed by /api/admin/upload for inline
    // images. Drag-and-drop and paste-from-clipboard both go through the
    // upload function, which inserts ![](r2-url) at the cursor on success.
    const bioMde = new EasyMDE({
      element: document.getElementById("bio-editor"),
      autoDownloadFontAwesome: true,
      spellChecker: false,
      status: ["lines", "words"],
      minHeight: "220px",
      toolbar: [
        "bold", "italic", "heading", "|",
        "quote", "unordered-list", "ordered-list", "|",
        "link", "image", "upload-image", "|",
        "preview", "side-by-side", "fullscreen", "|",
        "guide",
      ],
      uploadImage: true,
      imageMaxSize: 5 * 1024 * 1024,
      imageAccept: "image/jpeg,image/png,image/webp",
      imageUploadFunction: async (file, onSuccess, onError) => {
        try {
          const body = new FormData();
          body.append("file", file);
          const res = await fetch("/api/admin/upload", { method: "POST", body });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            onError(data.error || "Upload failed.");
            return;
          }
          const data = await res.json();
          onSuccess(data.url);
        } catch {
          onError("Network error during upload.");
        }
      },
    });

    // Subcategory cascade
    const catSel = document.getElementById("categoryId");
    const subSel = document.getElementById("subcategoryId");
    const byId = Object.fromEntries(categories.map((c) => [c.id, c.subcategories]));
    catSel.addEventListener("change", () => {
      const subs = byId[catSel.value] || [];
      subSel.innerHTML =
        '<option value="">—</option>' +
        subs.map((s) => `<option value="${s.id}">${s.name}</option>`).join("");
    });

    // Image upload — uploads to R2 immediately on file selection, stashes the
    // returned URL in the hidden imageUrl input. The form submit reads that
    // hidden value just like the old URL paste field.
    const fileInput = document.getElementById("image-file");
    const urlInput = document.querySelector('input[name="imageUrl"]');
    const status = document.getElementById("image-status");
    const preview = document.getElementById("image-preview");
    const previewImg = document.getElementById("image-preview-img");
    const removeBtn = document.getElementById("image-remove");

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        status.textContent = "That file is bigger than 5 MB. Pick a smaller image.";
        status.className = "text-xs text-red-600 mt-1";
        fileInput.value = "";
        return;
      }

      status.textContent = "Uploading…";
      status.className = "text-xs text-gem-text-muted mt-1";

      const body = new FormData();
      body.append("file", file);

      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          status.textContent = data.error || "Upload failed.";
          status.className = "text-xs text-red-600 mt-1";
          fileInput.value = "";
          return;
        }
        const data = await res.json();
        urlInput.value = data.url;
        previewImg.src = data.url;
        preview.classList.remove("hidden");
        status.textContent = "Uploaded ✓";
        status.className = "text-xs text-green-700 mt-1";
      } catch {
        status.textContent = "Network error during upload.";
        status.className = "text-xs text-red-600 mt-1";
        fileInput.value = "";
      }
    });

    removeBtn.addEventListener("click", () => {
      urlInput.value = "";
      fileInput.value = "";
      preview.classList.add("hidden");
      previewImg.src = "";
      status.textContent = "JPEG, PNG, or WebP. Max 5 MB. Optional — you can add it later.";
      status.className = "text-xs text-gem-text-subtle mt-1";
    });

    // Add another social row
    const socialPlatforms = [
      "INSTAGRAM","FACEBOOK","TIKTOK","TWITTER","YOUTUBE","LINKEDIN","YELP","TRIPADVISOR","OTHER",
    ];
    document.getElementById("add-social").addEventListener("click", () => {
      const row = document.createElement("div");
      row.className = "flex gap-2 social-row";
      row.innerHTML =
        '<select name="social-platform" class="px-3 py-2 rounded-lg border border-gem-border bg-white text-sm">' +
        socialPlatforms.map((p) => `<option value="${p}">${p}</option>`).join("") +
        '</select>' +
        '<input name="social-url" type="url" placeholder="https://…" class="flex-1 px-3 py-2 rounded-lg border border-gem-border" />';
      document.getElementById("socials").appendChild(row);
    });

    // Submit
    const form = document.getElementById("biz-form");
    const btn = document.getElementById("submit-btn");
    const errEl = document.getElementById("form-error");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.classList.add("hidden");
      btn.disabled = true;
      btn.textContent = "Saving…";

      const fd = new FormData(form);
      const keywords = (fd.get("keywords") || "").toString()
        .split(",").map((k) => k.trim()).filter(Boolean);

      const socials = Array.from(document.querySelectorAll(".social-row")).map((row) => ({
        platform: row.querySelector('[name="social-platform"]').value,
        url: row.querySelector('[name="social-url"]').value.trim(),
      })).filter((s) => s.url);

      const payload = {
        name: fd.get("name"),
        slug: fd.get("slug") || undefined,
        categoryId: fd.get("categoryId"),
        subcategoryId: fd.get("subcategoryId") || undefined,
        bio: bioMde.value() || undefined,
        editorialBlurb: fd.get("editorialBlurb") || undefined,
        websiteUrl: fd.get("websiteUrl") || undefined,
        bookingUrl: fd.get("bookingUrl") || undefined,
        pricePoint: fd.get("pricePoint") || undefined,
        status: fd.get("status") || "APPROVED",
        keywords,
        isVerified: fd.get("isVerified") === "1",
        location: {
          address: fd.get("address"),
          city: fd.get("city"),
          state: fd.get("state") || "ID",
          zip: fd.get("zip"),
          neighborhood: fd.get("neighborhood") || undefined,
          lat: fd.get("lat") ? Number(fd.get("lat")) : undefined,
          lng: fd.get("lng") ? Number(fd.get("lng")) : undefined,
        },
        phone: fd.get("phone") || undefined,
        email: fd.get("email") || undefined,
        imageUrl: fd.get("imageUrl") || undefined,
        imageAlt: fd.get("imageAlt") || undefined,
        socials,
      };

      try {
        const res = await fetch("/api/admin/businesses", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          errEl.textContent = data?.error || "Could not save listing.";
          errEl.classList.remove("hidden");
          btn.disabled = false;
          btn.textContent = "Save listing";
          return;
        }
        const data = await res.json();
        window.location.href = `/admin/businesses/${data.id}`;
      } catch {
        errEl.textContent = "Network error. Please try again.";
        errEl.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Save listing";
      }
    });
  </script>
</AdminLayout>
