---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db } from "@/lib/db";
import { business } from "@/lib/db/schema";
import { desc, eq, ilike, and, type SQL } from "drizzle-orm";

const url = new URL(Astro.request.url);
const q = url.searchParams.get("q")?.trim() ?? "";
const status = url.searchParams.get("status") ?? "ALL";

const conditions: SQL[] = [];
if (q) conditions.push(ilike(business.name, `%${q}%`));
if (status !== "ALL") {
  conditions.push(
    eq(
      business.status,
      status as "DRAFT" | "PENDING_REVIEW" | "APPROVED" | "REJECTED" | "SUSPENDED"
    )
  );
}

const rows = await db.query.business.findMany({
  where: conditions.length ? and(...conditions) : undefined,
  with: { category: true, locations: { limit: 1 } },
  orderBy: desc(business.createdAt),
  limit: 200,
});

const statuses = ["ALL", "APPROVED", "DRAFT", "PENDING_REVIEW", "REJECTED", "SUSPENDED"];
---

<AdminLayout title="Businesses" activeSection="businesses">
  <div slot="page-header" class="flex items-center justify-between mb-6 gap-4 flex-wrap">
    <div>
      <h1 class="font-display text-3xl text-gem-text">Businesses</h1>
      <p class="text-gem-text-muted text-sm mt-1">{rows.length} shown</p>
    </div>
    <a
      href="/admin/businesses/new"
      class="bg-gem-gold text-gem-dark font-semibold px-4 py-2 rounded-lg hover:bg-gem-gold-light transition-colors no-underline"
    >
      + New Listing
    </a>
  </div>

  <form method="get" class="flex items-center gap-2 mb-4 flex-wrap bg-white border border-gem-border rounded-2xl p-3">
    <input
      type="search"
      name="q"
      value={q}
      placeholder="Search by name…"
      class="flex-1 min-w-[200px] px-3 py-2 rounded-lg border border-gem-border bg-white text-sm focus:outline-none focus:ring-2 focus:ring-gem-gold"
    />
    <select
      name="status"
      class="px-3 py-2 rounded-lg border border-gem-border bg-white text-sm focus:outline-none focus:ring-2 focus:ring-gem-gold"
    >
      {statuses.map((s) => (
        <option value={s} selected={s === status}>{s.replace("_", " ")}</option>
      ))}
    </select>
    <button
      type="submit"
      class="px-4 py-2 rounded-lg bg-gem-text text-white text-sm font-medium hover:bg-gem-stone transition-colors"
    >
      Filter
    </button>
  </form>

  <div class="bg-white border border-gem-border rounded-2xl overflow-hidden">
    {rows.length === 0 ? (
      <div class="p-8 text-center">
        <p class="text-gem-text-muted text-sm mb-3">No businesses match.</p>
        <a href="/admin/businesses/new" class="text-gem-gold hover:underline text-sm">+ Add your first listing</a>
      </div>
    ) : (
      <table class="w-full text-sm">
        <thead class="bg-gem-mist text-left text-xs uppercase tracking-widest text-gem-text-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Name</th>
            <th class="px-4 py-3 font-semibold">Category</th>
            <th class="px-4 py-3 font-semibold">City</th>
            <th class="px-4 py-3 font-semibold">Status</th>
            <th class="px-4 py-3 font-semibold w-24"></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((b) => (
            <tr class="border-t border-gem-border hover:bg-gem-mist/50">
              <td class="px-4 py-3">
                <a href={`/admin/businesses/${b.id}`} class="font-medium text-gem-text hover:text-gem-gold no-underline">{b.name}</a>
              </td>
              <td class="px-4 py-3 text-gem-text-muted">{b.category?.name ?? "—"}</td>
              <td class="px-4 py-3 text-gem-text-muted">{b.locations?.[0]?.city ?? "—"}</td>
              <td class="px-4 py-3">
                <span class:list={[
                  "inline-block px-2 py-0.5 rounded-full text-xs font-medium",
                  b.status === "APPROVED" && "bg-green-100 text-green-700",
                  b.status === "DRAFT" && "bg-gray-100 text-gray-700",
                  b.status === "PENDING_REVIEW" && "bg-yellow-100 text-yellow-800",
                  b.status === "REJECTED" && "bg-red-100 text-red-700",
                  b.status === "SUSPENDED" && "bg-orange-100 text-orange-700",
                ]}>
                  {b.status.replace("_", " ")}
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <a href={`/listings/${b.slug}`} target="_blank" rel="noopener" class="text-xs text-gem-text-muted hover:text-gem-gold">View ↗</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>
